# Data Import:

import pandas as pd
import json
import os

# Official FPV-DB dataset
BASE_URL = (
    "https://raw.githubusercontent.com/"
    "fpvdb/fpv-db-data/main/"
)

DATASETS = {
    "motors": "motor",
    "batteries": "battery",
    "props": "propeller",
    "stacks": "flight_controller_esc_stack",
    "cameras": "camera",
    "vtx": "video_transmitter",
    "quads": "complete_drone"
}

FUNCTIONS = {
    "motor": "propulsion|thrust_generation",
    "battery": "energy_storage|power_supply",
    "propeller": "propulsion|thrust_generation",
    "flight_controller_esc_stack":
        "flight_control|motor_control",
    "camera": "imaging|visual_sensing",
    "video_transmitter": "video_transmission",
    "complete_drone": "complete_aircraft"
}


def find_value(row, possible_names):

    for name in possible_names:
        if name in row and pd.notna(row[name]):
            return row[name]

    return ""


def main():

    os.makedirs("data", exist_ok=True)

    all_parts = []

    for filename, component_type in DATASETS.items():

        url = BASE_URL + filename + ".csv"

        print(f"Downloading {filename}...")

        try:
            df = pd.read_csv(url)

        except Exception as error:
            print(f"Could not download {filename}: {error}")
            continue

        for _, row in df.iterrows():

            original = row.to_dict()

            # Preserve the complete original record
            raw_json = json.dumps(
                original,
                default=str,
                ensure_ascii=False
            )

            part = {
                "part_id": find_value(
                    row,
                    ["slug", "id", "part_id"]
                ),

                "manufacturer": find_value(
                    row,
                    ["manufacturer", "brand", "make"]
                ),

                "model": find_value(
                    row,
                    ["model", "name", "title"]
                ),

                "component_type": component_type,

                "weight_g": find_value(
                    row,
                    ["weight_g", "weight"]
                ),

                "voltage": find_value(
                    row,
                    ["voltage", "voltage_v"]
                ),

                "kv": find_value(
                    row,
                    ["kv", "motor_kv"]
                ),

                "rated_current_a": find_value(
                    row,
                    ["rated_current_a", "current_a"]
                ),

                "capacity_mah": find_value(
                    row,
                    ["capacity_mah", "capacity"]
                ),

                # Labels based on component identity
                "functional_labels": FUNCTIONS.get(
                    component_type, ""
                ),

                # Leave these blank until supported
                # by manufacturer documentation
                "application_labels": "",
                "performance_labels": "",
                "compatible_parts": "",

                "classification_status": "needs_review",

                "source": "FPV-DB",
                "source_url": "https://fpv-db.com",

                "source_record_json": raw_json
            }

            all_parts.append(part)

    if not all_parts:
        raise RuntimeError(
            "No records downloaded. Check your internet connection."
        )

    result = pd.DataFrame(all_parts)

    output_file = "data/drone_parts.csv"

    result.to_csv(
        output_file,
        index=False,
        encoding="utf-8-sig"
    )

    print("\nDatabase successfully created!")
    print(f"Total records: {len(result)}")
    print(f"Output: {output_file}")

    print("\nComponent breakdown:")
    print(result["component_type"].value_counts())


if __name__ == "__main__":
    main()
